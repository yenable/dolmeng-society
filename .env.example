# 돌멩민국 슬랑이 시장 — 환경변수
# Vercel: Project → Settings → Environment Variables 에 아래 4개를 넣습니다. (Production·Preview 모두)
# 로컬: 이 파일을 .env 로 복사해서 값을 채우면 npm run dev 가 Supabase 에 연결됩니다. (.env 는 git 에 올라가지 않음)

# Supabase → Project Settings → API (Data API) 의 Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# [브라우저 공개 가능] anon(public) 키 — 학생/TV 화면이 Realtime 변경 신호를 받는 데만 사용
# (RLS 로 session_pulse 테이블 읽기만 허용되어 있어 게임 데이터는 읽을 수 없음)
SUPABASE_ANON_KEY=

# [서버 전용 · 절대 공개 금지] service_role 키 — Vercel 서버 함수에서만 사용
SUPABASE_SERVICE_ROLE_KEY=

# 교사 PIN (교사 콘솔 /admin, TV 프레젠터 모드). 비우면 기본값 2580. 수업 전에 꼭 바꾸세요.
ADMIN_PIN=
